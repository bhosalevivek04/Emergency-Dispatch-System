{
  "name": "tracking-client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "leaflet": "^1.9.4",
    "leaflet-rotatedmarker": "^0.2.0",
    "leaflet-routing-machine": "^3.2.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "react-scripts": "5.0.1",
    "sockjs-client": "^1.6.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "docker:build": "docker build -t tracking-client .",
    "docker:run": "docker run -p 3001:80 tracking-client",
    "services:start": "cd .. && docker-compose up -d kafka redis tracking-service",
    "services:stop": "cd .. && docker-compose down",
    "services:logs": "cd .. && docker-compose logs -f tracking-service"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
