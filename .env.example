# Database Configuration
POSTGRES_DB=emergency_dispatch
POSTGRES_USER=dispatch_user
POSTGRES_PASSWORD=your_secure_password_here

# Kafka Configuration
KAFKA_CLUSTER_ID=your_unique_cluster_id_here

# CORS Configuration (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Redis Configuration (optional overrides)
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka Bootstrap Servers (optional override)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Ambulance Fleet Configuration (comma-separated list)
AMBULANCE_FLEET_IDS=AMB-101,AMB-102,AMB-103
