import apiClient from './apiClient.js';

/**
 * Typed API functions for the Emergency Dispatch System.
 *
 * Bug 4 Fix: Emergency create payload now sends correct field names (latitude/longitude)
 *            and auto-generates emergencyId client-side as fallback.
 *
 * Bug 5 Fix: All emergency responses are normalized so components always receive
 *            { id: string (emergencyId), latitude: number, longitude: number, ... }
 *            instead of raw { id: Long, emergencyId: string, latitude: BigDecimal, ... }
 *
 * Bug 7 Fix: ambulanceApi.getFleet() merges fleet state (status/version from ambulance-service)
 *            with live location data (lat/lon/speed from tracking-service) into one array.
 *
 * Bug 8 Fix: ambulanceApi.getById() now uses the new GET /ambulance/{id} endpoint.
 */

// ── Helpers ──────────────────────────────────────────────────────────────────

/**
 * Normalize raw Emergency entity from backend into a consistent frontend shape.
 * Backend returns: { id: Long, emergencyId: String, latitude: BigDecimal, ... }
 * Frontend expects: { id: String, latitude: Number, longitude: Number, ... }
 */
function normalizeEmergency(e) {
  return {
    ...e,
    id: e.emergencyId || String(e.id),   // use business ID as primary key
    latitude: Number(e.latitude),
    longitude: Number(e.longitude),
    createdAt: e.createdAt || new Date().toISOString(),
  };
}

