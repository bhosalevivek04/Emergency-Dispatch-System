export const emergencyApi = {
  /**
   * Bug 4 Fix: sends correct field names to match EmergencyEvent DTO.
   * Backend now accepts latitude/longitude (fixed DTO) and auto-generates emergencyId.
   */
  create: (data) =>
    apiClient.post('/api/emergencies', {
      latitude: data.latitude,
      longitude: data.longitude,
      priority: data.priority,
    }).then(res => normalizeEmergency(res.data)),

  /** Bug 5 Fix: normalize response */
  getById: (id) =>
    apiClient.get(`/api/emergencies/${id}`).then(res => normalizeEmergency(res.data)),

  /** Bug 5 Fix: normalize every item in the list */
  getByStatus: (status) =>
    apiClient.get(`/api/emergencies/status/${status}`)
      .then(res => (Array.isArray(res.data) ? res.data : []).map(normalizeEmergency)),

  /**
   * Bug 6 Fix: PUT /api/emergencies/{id}/status — new endpoint added to backend.
   * Used by DriverDashboard to update mission status.
   */
  updateStatus: (id, status) =>
    apiClient.put(`/api/emergencies/${id}/status`, { status })
      .then(res => normalizeEmergency(res.data)),
};

