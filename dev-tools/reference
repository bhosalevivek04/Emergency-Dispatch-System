/**
 * DispatcherDashboard
 *
 * Bug 2 Fix: Only subscribes to /topic/location (the only topic the backend publishes).
 *            Emergency status changes are polled every 15s instead of via non-existent WS topics.
 * Bug 7 Fix: ambulanceApi.getFleet() now returns merged array with lat/lon/speed.
 */
const DispatcherDashboard = () => {
  const { user, logout, accessToken } = useAuth();
  const { showToast } = useToast();

  const [emergencies, setEmergencies] = useState([]);
  const [ambulances, setAmbulances] = useState({});  // keyed by id for fast WS updates
  const [isLoadingEmergencies, setIsLoadingEmergencies] = useState(true);
  const [isLoadingAmbulances, setIsLoadingAmbulances] = useState(true);
  const [isLoadingMap, setIsLoadingMap] = useState(true);
  const [wsConnectionState, setWsConnectionState] = useState('disconnected');
  const [selectedEmergency, setSelectedEmergency] = useState(null);
  const [selectedAmbulance, setSelectedAmbulance] = useState(null);
  const [mapClickMode, setMapClickMode] = useState(false);

  const pollIntervalRef = useRef(null);

  // ── Data fetching ────────────────────────────────────────────────────────

  const fetchEmergencies = useCallback(async () => {
    try {
      const [pending, assigned] = await Promise.all([
        emergencyApi.getByStatus('PENDING'),
        emergencyApi.getByStatus('ASSIGNED'),
      ]);
      setEmergencies([...pending, ...assigned]);
    } catch (error) {
      console.error('Error fetching emergencies:', error);
      setEmergencies([]);
      if (!error.response) showToast('Cannot reach server. Check your connection.', 'error');
      else if (error.response?.status === 403) showToast('Access denied to emergencies.', 'error');
    } finally {
      setIsLoadingEmergencies(false);
    }
  }, [showToast]);

  const fetchAmbulances = useCallback(async () => {
    try {
      // Bug 7 Fix: returns merged array with lat/lon/speed
      const fleet = await ambulanceApi.getFleet();
      const fleetMap = {};
      fleet.forEach(a => { fleetMap[a.id] = a; });
      setAmbulances(fleetMap);
    } catch (error) {
      console.error('Error fetching ambulances:', error);
      setAmbulances({});
    } finally {
      setIsLoadingAmbulances(false);
      setIsLoadingMap(false);
    }
  }, []);

  // ── Emergency creation ────────────────────────────────────────────────────

  const handleCreateEmergency = async (latitude, longitude, priority) => {
    try {
      const newEmergency = await emergencyApi.create({ latitude, longitude, priority });
      setEmergencies(prev => [...prev, newEmergency]);
      showToast(`Emergency ${newEmergency.id} created`, 'success');
      return newEmergency;
    } catch (error) {
      console.error('Error creating emergency:', error);
      const msg = error.response?.status === 400
        ? 'Invalid emergency data.'
        : error.response?.status === 403
          ? 'Access denied: cannot create emergencies.'
          : 'Failed to create emergency.';
      showToast(msg, 'error');
      throw error;
    }
  };

  // ── WebSocket for live ambulance locations ────────────────────────────────

  useEffect(() => {
    if (!accessToken) return;

    let unsubLocation;
    let reconnectTimeout;

    const connectWS = async () => {
      try {
        setWsConnectionState('connecting');
        await wsService.connect(accessToken);
        setWsConnectionState('connected');

        // Bug 2 Fix: only /topic/location exists on backend
        unsubLocation = wsService.subscribe('/topic/location', (update) => {
          // update shape: { ambulanceId, latitude, longitude, speed, heading, timestamp }
          setAmbulances(prev => {
            const existing = prev[update.ambulanceId] || {};
            return {
              ...prev,
              [update.ambulanceId]: {
                ...existing,
                id: update.ambulanceId,
                latitude: update.latitude,
                longitude: update.longitude,
                speed: update.speed ?? existing.speed ?? 0,
                heading: update.heading ?? existing.heading ?? 0,
              },
            };
          });
        });
      } catch (error) {
        console.error('WS connection failed:', error);
        setWsConnectionState('error');
        showToast('Real-time location updates unavailable.', 'warning');
        reconnectTimeout = setTimeout(() => {
          if (accessToken) connectWS();
        }, 5000);
      }
    };

    connectWS();

    return () => {
      clearTimeout(reconnectTimeout);
      if (unsubLocation) unsubLocation();
      wsService.disconnect();
      setWsConnectionState('disconnected');
    };
  }, [accessToken, showToast]);

  // ── Poll emergencies every 15s for status changes ─────────────────────────
  // (replaces non-existent /topic/emergencies WebSocket topic)

  useEffect(() => {
    fetchEmergencies();
    fetchAmbulances();

    pollIntervalRef.current = setInterval(fetchEmergencies, 15000);
    return () => clearInterval(pollIntervalRef.current);
  }, [fetchEmergencies, fetchAmbulances]);

  const ambulanceArray = Object.values(ambulances);

  return (
    <div className="dispatcher-dashboard">
      <header className="dashboard-header">
        <h1>Dispatcher Dashboard</h1>
        <div className="header-actions">
          <span className="user-info">Welcome, {user?.username}</span>
          <ConnectionStatus status={wsConnectionState} />
          <button onClick={logout} className="logout-button">Logout</button>
        </div>
      </header>

      <main className="dashboard-content">
        {/* Map panel — 60% */}
        <div className="map-panel">
          {isLoadingMap ? (
            <SkeletonLoader type="map" />
          ) : (
            <>
              <MapComponent
                center={[18.5204, 73.8567]}
                zoom={13}
                onMapClick={mapClickMode ? (lat, lng) => {
                  if (window.emergencyCreationControl?.handleLocationSelect) {
                    window.emergencyCreationControl.handleLocationSelect(lat, lng);
                  }
                } : undefined}
              >
                {emergencies.map(emergency => (
                  <EmergencyMarker
                    key={emergency.id}
                    emergency={emergency}
                    onClick={() => { setSelectedEmergency(emergency); setSelectedAmbulance(null); }}
                  />
                ))}
                {ambulanceArray
                  .filter(a => a.latitude && a.longitude)
                  .map(ambulance => (
                    <AmbulanceMarker
                      key={ambulance.id}
                      ambulance={ambulance}
                      onClick={() => { setSelectedAmbulance(ambulance); setSelectedEmergency(null); }}
                    />
                  ))}
              </MapComponent>

              <EmergencyCreationControl
                onEmergencyCreated={(e) => setEmergencies(prev => [...prev, e])}
                onModeChange={setMapClickMode}
                showToast={showToast}
              />
            </>
          )}
        </div>

        {/* Side panel — 40% */}
        <div className="side-panel">
          {isLoadingEmergencies ? (
            <SkeletonLoader type="card" count={3} />
          ) : (
            <EmergencyQueuePanel
              emergencies={emergencies}
              onEmergencyClick={(e) => { setSelectedEmergency(e); setSelectedAmbulance(null); }}
            />
          )}

          {isLoadingAmbulances ? (
            <SkeletonLoader type="table" count={5} />
          ) : (
            <FleetStatusPanel ambulances={ambulanceArray} />
          )}
        </div>
      </main>
    </div>
  );
};

