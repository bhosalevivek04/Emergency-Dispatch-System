### FILE 2 — `tracking-service/src/main/java/com/vivek/tracking/listener/TrackingLocationListener.java`

**Problem:** `throws JsonProcessingException` propagates out of the `@KafkaListener`, causing Spring Kafka to retry every bad-JSON message infinitely until it hits the DLT retry limit — burning cycles on something that will never succeed.

```java
package com.vivek.tracking.listener;

import io.micrometer.core.instrument.MeterRegistry;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.kafka.annotation.KafkaListener;
import org.springframework.messaging.simp.SimpMessagingTemplate;
import org.springframework.stereotype.Component;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.vivek.tracking.dto.AmbulanceLocationEvent;
import com.vivek.tracking.service.TrackingCacheService;

@Component
@Slf4j
@RequiredArgsConstructor
public class TrackingLocationListener {

    private final ObjectMapper objectMapper;
    private final TrackingCacheService trackingCacheService;
    private final SimpMessagingTemplate messagingTemplate;
    private final MeterRegistry meterRegistry;

    @Value("${tracking.listener.log.enabled:true}")
    private boolean logEnabled;

    @KafkaListener(topics = "ambulance-location-topic", groupId = "tracking-group")
    public void consumeAmbulanceLocation(String message) {
        // DO NOT declare `throws JsonProcessingException`.
        // Bad JSON on a high-frequency location topic (every 1-3s per ambulance) would cause
        // a storm of retries + DLT writes. Parse errors must be discarded immediately.
        AmbulanceLocationEvent event;
        try {
            event = objectMapper.readValue(message, AmbulanceLocationEvent.class);
        } catch (JsonProcessingException e) {
            meterRegistry.counter("tracking.location.parse_error.total").increment();
            log.error("Malformed location message in tracking-service — discarding: {}", message, e);
            return; // discard — do not retry bad JSON
        }

        // Cache latest position in Redis (or in-memory fallback)
        try {
            trackingCacheService.saveLatest(event);
        } catch (Exception e) {
            // Cache failure is non-fatal — we can still broadcast to WebSocket clients
            meterRegistry.counter("tracking.cache.save_error.total").increment();
            log.warn("Failed to cache location for ambulanceId={} — WebSocket broadcast will still proceed",
                    event.getAmbulanceId(), e);
        }

        // Broadcast to all connected WebSocket clients
        try {
            messagingTemplate.convertAndSend("/topic/location", event);
            meterRegistry.counter("tracking.websocket.broadcast.total").increment();
        } catch (Exception e) {
            // WebSocket failure is also non-fatal — don't fail the Kafka consumer over it
            meterRegistry.counter("tracking.websocket.broadcast_error.total").increment();
            log.warn("WebSocket broadcast failed for ambulanceId={}", event.getAmbulanceId(), e);
        }

        meterRegistry.counter("tracking.location.consumed.total").increment();

        if (logEnabled) {
            log.debug("Location processed ambulanceId={} lat={} lon={}",
                    event.getAmbulanceId(), event.getLatitude(), event.getLongitude());
        }
    }
}
