export const ambulanceApi = {
  /**
   * Bug 7 Fix: merge fleet state (status/version) with tracking locations (lat/lon/speed).
   *
   * GET /api/ambulances/fleet returns:
   *   { fleet: { "AMB-101": { status, version, available } }, total: 3 }
   *
   * GET /api/tracking/ambulances returns:
   *   { "AMB-101": { ambulanceId, latitude, longitude, speed, heading, timestamp }, ... }
   *
   * We merge both into a flat array with all fields so AmbulanceMarker renders correctly.
   */
  getFleet: async () => {
    const [fleetRes, trackingRes] = await Promise.all([
      apiClient.get('/api/ambulances/fleet'),
      apiClient.get('/api/tracking/ambulances').catch(() => ({ data: {} })), // graceful fallback
    ]);

    const fleetMap = fleetRes.data?.fleet || {};
    // tracking returns either a Map<String,Event> or an array — normalize to map
    const rawTracking = trackingRes.data || {};
    const locationMap = Array.isArray(rawTracking)
      ? rawTracking.reduce((acc, loc) => { acc[loc.ambulanceId] = loc; return acc; }, {})
      : rawTracking;

    return Object.entries(fleetMap).map(([id, state]) => {
      const loc = locationMap[id] || {};
      return {
        id,
        status: state.status || 'UNKNOWN',
        version: state.version ?? 0,
        available: state.available ?? false,
        latitude: Number(loc.latitude ?? 18.5204),
        longitude: Number(loc.longitude ?? 73.8567),
        speed: Number(loc.speed ?? 0),
        heading: Number(loc.heading ?? 0),
      };
    });
  },

  getAvailable: () =>
    apiClient.get('/api/ambulances/available').then(res => res.data),

  /**
   * Bug 8 Fix: uses GET /api/ambulances/{id} — new endpoint added to backend.
   * Returns merged ambulance state + location.
   */
  getById: async (id) => {
    const [stateRes, locRes] = await Promise.all([
      apiClient.get(`/api/ambulances/${id}`),
      apiClient.get(`/api/tracking/ambulances/${id}`).catch(() => ({ data: {} })),
    ]);
    const state = stateRes.data || {};
    const loc = locRes.data || {};
    return {
      id: state.id || id,
      status: state.status || 'AVAILABLE',
      version: state.version ?? 0,
      available: state.available ?? true,
      latitude: Number(loc.latitude ?? 18.5204),
      longitude: Number(loc.longitude ?? 73.8567),
      speed: Number(loc.speed ?? 0),
      heading: Number(loc.heading ?? 0),
      assignedEmergencyId: state.assignedEmergencyId || null,
    };
  },
};

