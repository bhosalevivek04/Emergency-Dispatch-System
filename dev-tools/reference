        <div className="map-panel">
          {isLoadingMap ? (
            <SkeletonLoader type="map" />
          ) : (
            <>
              <MapComponent
                center={[18.5204, 73.8567]}
                zoom={13}
                onMapClick={mapClickMode ? (lat, lng) => {
                  window.emergencyCreationControl?.handleLocationSelect?.(lat, lng);
                } : undefined}
              >
                {emergencies.map(emergency => (
                  <EmergencyMarker key={emergency.id} emergency={emergency} />
                ))}
                {ambulanceArray
                  .filter(a => a.latitude && a.longitude)
                  .map(ambulance => (
                    <AmbulanceMarker key={ambulance.id} ambulance={ambulance} />
                  ))}
              </MapComponent>
              <EmergencyCreationControl
                onEmergencyCreated={(e) => setEmergencies(prev => [...prev, e])}
                onModeChange={setMapClickMode}
                showToast={showToast}
              />
            </>
          )}
        </div>

        <div className="side-panel">
          {isLoadingEmergencies ? <SkeletonLoader type="card" count={3} /> : (
            <EmergencyQueuePanel emergencies={emergencies} />
          )}

          {isLoadingAmbulances ? <SkeletonLoader type="table" count={5} /> : (
            <FleetStatusPanel ambulances={ambulanceArray} />
          )}

          <FleetManagementPanel />
          <SystemHealthPanel />

          <div className="metrics-link-panel">
            <h2>System Metrics</h2>
            <p>View detailed metrics in Grafana.</p>
            <a href="http://localhost:3001" target="_blank" rel="noopener noreferrer"
               className="grafana-link-button">
              Open Grafana Dashboard
            </a>
          </div>
        </div>
      </main>
    </div>
  );
};

export default AdminDashboard;
